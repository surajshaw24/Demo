<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GPS Dashboard | Fastag GPS</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <style>
        :root {
            --primary: #2c3e50;
            --secondary: #3498db;
            --accent: #e74c3c;
            --success: #27ae60;
            --warning: #f39c12;
            --light: #ecf0f1;
            --dark: #2c3e50;
            --gray: #7f8c8d;
            --shadow: 0 5px 15px rgba(0,0,0,0.1);
            --transition: all 0.3s ease;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f5f7fa;
            color: #333;
            overflow-x: hidden;
        }
        
        /* Dashboard Layout */
        .dashboard-container {
            display: flex;
            min-height: 100vh;
        }
        
        /* Sidebar */
        .sidebar {
            width: 250px;
            background-color: var(--primary);
            color: white;
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            z-index: 1000;
            transition: var(--transition);
        }
        
        .sidebar-logo {
            padding: 25px 20px;
            border-bottom: 1px solid #34495e;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .sidebar-logo i {
            font-size: 1.8rem;
            color: var(--secondary);
        }
        
        .sidebar-logo h2 {
            font-size: 1.5rem;
        }
        
        .sidebar-menu {
            list-style: none;
            padding: 20px 0;
        }
        
        .sidebar-menu li {
            margin-bottom: 5px;
        }
        
        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 15px 20px;
            color: #bdc3c7;
            text-decoration: none;
            transition: var(--transition);
            position: relative;
        }
        
        .sidebar-menu a:hover {
            background-color: #34495e;
            color: white;
        }
        
        .sidebar-menu a.active {
            background-color: var(--secondary);
            color: white;
        }
        
        .sidebar-menu a.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 4px;
            background-color: white;
        }
        
        .sidebar-menu i {
            width: 20px;
            text-align: center;
            font-size: 1.1rem;
        }
        
        .menu-badge {
            margin-left: auto;
            background-color: var(--accent);
            color: white;
            font-size: 0.7rem;
            padding: 2px 8px;
            border-radius: 10px;
        }
        
        /* Main Content */
        .main-content {
            flex: 1;
            margin-left: 250px;
            padding: 20px;
            transition: var(--transition);
        }
        
        /* Top Header */
        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 0;
            margin-bottom: 25px;
            border-bottom: 1px solid #e0e0e0;
        }
        
        .page-title h1 {
            font-size: 1.8rem;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .page-title p {
            color: var(--gray);
            font-size: 0.9rem;
        }
        
        .header-controls {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        
        .date-picker {
            background-color: white;
            padding: 10px 15px;
            border-radius: 5px;
            border: 1px solid #ddd;
            font-family: 'Poppins', sans-serif;
            cursor: pointer;
        }
        
        .user-profile {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--secondary), var(--primary));
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 1.2rem;
        }
        
        .notification-btn {
            position: relative;
            background: none;
            border: none;
            font-size: 1.3rem;
            color: var(--primary);
            cursor: pointer;
        }
        
        .notification-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background-color: var(--accent);
            color: white;
            font-size: 0.7rem;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        /* Stats Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .stat-card {
            background-color: white;
            border-radius: 10px;
            padding: 20px;
            box-shadow: var(--shadow);
            display: flex;
            align-items: center;
            gap: 15px;
            transition: var(--transition);
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }
        
        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: white;
        }
        
        .stat-1 { background: linear-gradient(135deg, #3498db, #2980b9); }
        .stat-2 { background: linear-gradient(135deg, #2ecc71, #27ae60); }
        .stat-3 { background: linear-gradient(135deg, #e74c3c, #c0392b); }
        .stat-4 { background: linear-gradient(135deg, #f39c12, #d35400); }
        .stat-5 { background: linear-gradient(135deg, #9b59b6, #8e44ad); }
        .stat-6 { background: linear-gradient(135deg, #1abc9c, #16a085); }
        
        .stat-info h3 {
            font-size: 1.8rem;
            color: var(--primary);
            margin-bottom: 5px;
        }
        
        .stat-info p {
            color: var(--gray);
            font-size: 0.9rem;
        }
        
        .stat-change {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 0.8rem;
            margin-top: 5px;
        }
        
        .positive { color: var(--success); }
        .negative { color: var(--accent); }
        
        /* Map Section */
        .map-section {
            background-color: white;
            border-radius: 10px;
            padding: 20px;
            box-shadow: var(--shadow);
            margin-bottom: 30px;
            height: 500px;
        }
        
        .map-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .map-header h2 {
            font-size: 1.3rem;
            color: var(--primary);
        }
        
        .map-controls {
            display: flex;
            gap: 10px;
        }
        
        .map-control-btn {
            padding: 8px 15px;
            background-color: var(--light);
            border: none;
            border-radius: 5px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 5px;
            font-family: 'Poppins', sans-serif;
            transition: var(--transition);
        }
        
        .map-control-btn:hover {
            background-color: var(--secondary);
            color: white;
        }
        
        #map {
            width: 100%;
            height: 400px;
            border-radius: 8px;
            overflow: hidden;
        }
        
        /* Charts Section */
        .charts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        @media (max-width: 1200px) {
            .charts-grid {
                grid-template-columns: 1fr;
            }
        }
        
        .chart-card {
            background-color: white;
            border-radius: 10px;
            padding: 20px;
            box-shadow: var(--shadow);
        }
        
        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .chart-header h3 {
            font-size: 1.2rem;
            color: var(--primary);
        }
        
        .chart-container {
            height: 300px;
            width: 100%;
        }
        
        /* Vehicles Table */
        .vehicles-section {
            background-color: white;
            border-radius: 10px;
            padding: 20px;
            box-shadow: var(--shadow);
            margin-bottom: 30px;
        }
        
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        
        .section-header h3 {
            font-size: 1.2rem;
            color: var(--primary);
        }
        
        .table-container {
            overflow-x: auto;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
        }
        
        thead {
            background-color: var(--light);
        }
        
        th {
            padding: 15px;
            text-align: left;
            color: var(--primary);
            font-weight: 600;
            border-bottom: 2px solid #ddd;
        }
        
        td {
            padding: 15px;
            border-bottom: 1px solid #eee;
        }
        
        tr:hover {
            background-color: #f9f9f9;
        }
        
        .vehicle-status {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 500;
        }
        
        .status-moving { background-color: #d5f4e6; color: #27ae60; }
        .status-idle { background-color: #fff4e6; color: #f39c12; }
        .status-stopped { background-color: #ffe6e6; color: #e74c3c; }
        
        .speed-indicator {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .speed-bar {
            width: 100px;
            height: 6px;
            background-color: #ecf0f1;
            border-radius: 3px;
            overflow: hidden;
        }
        
        .speed-fill {
            height: 100%;
            border-radius: 3px;
        }
        
        .speed-normal { background-color: #2ecc71; }
        .speed-warning { background-color: #f39c12; }
        .speed-danger { background-color: #e74c3c; }
        
        /* Alerts Panel */
        .alerts-panel {
            background-color: white;
            border-radius: 10px;
            padding: 20px;
            box-shadow: var(--shadow);
        }
        
        .alert-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px 0;
            border-bottom: 1px solid #eee;
        }
        
        .alert-item:last-child {
            border-bottom: none;
        }
        
        .alert-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1rem;
        }
        
        .alert-high { background-color: #e74c3c; }
        .alert-medium { background-color: #f39c12; }
        .alert-low { background-color: #3498db; }
        
        .alert-info h4 {
            font-size: 0.95rem;
            margin-bottom: 5px;
        }
        
        .alert-info p {
            font-size: 0.8rem;
            color: var(--gray);
        }
        
        .alert-time {
            margin-left: auto;
            font-size: 0.8rem;
            color: var(--gray);
        }
        
        /* Toggle Switch */
        .toggle-switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 24px;
        }
        
        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        
        .toggle-slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: .4s;
        }
        
        .toggle-slider:before {
            position: absolute;
            content: "";
            height: 16px;
            width: 16px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: .4s;
        }
        
        input:checked + .toggle-slider {
            background-color: var(--success);
        }
        
        input:checked + .toggle-slider:before {
            transform: translateX(26px);
        }
        
        .toggle-slider.round {
            border-radius: 34px;
        }
        
        .toggle-slider.round:before {
            border-radius: 50%;
        }
        
        /* Responsive */
        @media (max-width: 1200px) {
            .sidebar {
                width: 70px;
            }
            
            .sidebar-logo span, .sidebar-menu span, .menu-badge {
                display: none;
            }
            
            .sidebar-logo {
                justify-content: center;
                padding: 25px 10px;
            }
            
            .sidebar-menu a {
                justify-content: center;
                padding: 15px 10px;
            }
            
            .main-content {
                margin-left: 70px;
            }
        }
        
        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
            }
            
            .sidebar.active {
                transform: translateX(0);
            }
            
            .main-content {
                margin-left: 0;
                padding: 15px;
            }
            
            .mobile-menu-btn {
                display: block;
                background: none;
                border: none;
                font-size: 1.5rem;
                color: var(--primary);
                cursor: pointer;
            }
            
            .stats-grid {
                grid-template-columns: 1fr;
            }
            
            .charts-grid {
                grid-template-columns: 1fr;
            }
            
            .map-section {
                height: 400px;
            }
            
            #map {
                height: 300px;
            }
        }
        
        /* Utility Classes */
        .btn {
            padding: 10px 20px;
            background-color: var(--secondary);
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-family: 'Poppins', sans-serif;
            font-weight: 500;
            transition: var(--transition);
        }
        
        .btn:hover {
            background-color: #2980b9;
            transform: translateY(-2px);
        }
        
        .btn-small {
            padding: 6px 12px;
            font-size: 0.85rem;
        }
        
        .btn-outline {
            background-color: transparent;
            border: 1px solid var(--secondary);
            color: var(--secondary);
        }
        
        .btn-outline:hover {
            background-color: var(--secondary);
            color: white;
        }
        
        .text-success { color: var(--success); }
        .text-warning { color: var(--warning); }
        .text-danger { color: var(--accent); }
        .text-primary { color: var(--primary); }
        
        .d-flex { display: flex; }
        .align-center { align-items: center; }
        .justify-between { justify-content: space-between; }
        .gap-10 { gap: 10px; }
        .gap-15 { gap: 15px; }
        .gap-20 { gap: 20px; }
        .mt-10 { margin-top: 10px; }
        .mt-20 { margin-top: 20px; }
        .mb-10 { margin-bottom: 10px; }
        .mb-20 { margin-bottom: 20px; }
        .p-10 { padding: 10px; }
        .p-20 { padding: 20px; }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <!-- Sidebar -->
        <div class="sidebar" id="sidebar">
            <div class="sidebar-logo">
                <i class="fas fa-satellite-dish"></i>
                <h2>Fastag GPS</h2>
            </div>
            
            <ul class="sidebar-menu">
                <li><a href="#" class="active">
                    <i class="fas fa-map-marked-alt"></i>
                    <span>GPS Dashboard</span>
                </a></li>
                
                <li><a href="#">
                    <i class="fas fa-gas-pump"></i>
                    <span>Diesel Dashboard</span>
                    <span class="menu-badge">3</span>
                </a></li>
                
                <li><a href="#">
                    <i class="fas fa-chart-bar"></i>
                    <span>Reports</span>
                </a></li>
                
                <li><a href="#">
                    <i class="fas fa-question-circle"></i>
                    <span>Devices</span>
                    <span class="menu-badge">12</span>
                </a></li>
                
                <li><a href="#">
                    <i class="fas fa-user-friends"></i>
                    <span>Drivers</span>
                </a></li>
                
                <li><a href="#">
                    <i class="fas fa-bookmark"></i>
                    <span>Saved Places</span>
                </a></li>
                
                <li><a href="#">
                    <i class="fas fa-users-cog"></i>
                    <span>UMS</span>
                </a></li>
                
                <li><a href="#">
                    <i class="fas fa-cog"></i>
                    <span>Settings</span>
                </a></li>
                
                <li><a href="#">
                    <i class="fas fa-tags"></i>
                    <span>Tags</span>
                </a></li>
                
                <li><a href="#">
                    <i class="fas fa-route"></i>
                    <span>Trips & Routes</span>
                </a></li>
                
                <li><a href="#">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Log Out</span>
                </a></li>
            </ul>
        </div>
        
        <!-- Main Content -->
        <div class="main-content">
            <!-- Top Header -->
            <div class="top-header">
                <div class="page-title">
                    <h1><i class="fas fa-map-marked-alt"></i> GPS Dashboard</h1>
                    <p>Real-time tracking and monitoring of your fleet vehicles</p>
                </div>
                
                <div class="header-controls">
                    <button class="mobile-menu-btn" id="mobileMenuBtn">
                        <i class="fas fa-bars"></i>
                    </button>
                    
                    <select class="date-picker">
                        <option>Today</option>
                        <option selected>Last 7 Days</option>
                        <option>This Month</option>
                        <option>Last Month</option>
                        <option>Custom Range</option>
                    </select>
                    
                    <button class="notification-btn">
                        <i class="fas fa-bell"></i>
                        <span class="notification-badge">5</span>
                    </button>
                    
                    <div class="user-profile">
                        <div class="avatar">AJ</div>
                        <div>
                            <h4>Admin User</h4>
                            <p>Fleet Manager</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Stats Cards -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon stat-1">
                        <i class="fas fa-car"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="activeVehicles">24</h3>
                        <p>Active Vehicles</p>
                        <div class="stat-change positive">
                            <i class="fas fa-arrow-up"></i>
                            <span>12% from yesterday</span>
                        </div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon stat-2">
                        <i class="fas fa-road"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="totalDistance">1,847 km</h3>
                        <p>Total Distance Today</p>
                        <div class="stat-change positive">
                            <i class="fas fa-arrow-up"></i>
                            <span>8% from yesterday</span>
                        </div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon stat-3">
                        <i class="fas fa-gas-pump"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="fuelUsed">412 L</h3>
                        <p>Fuel Used Today</p>
                        <div class="stat-change negative">
                            <i class="fas fa-arrow-down"></i>
                            <span>5% from yesterday</span>
                        </div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon stat-4">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="activeAlerts">3</h3>
                        <p>Active Alerts</p>
                        <div class="stat-change positive">
                            <i class="fas fa-arrow-down"></i>
                            <span>40% from yesterday</span>
                        </div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon stat-5">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="idleTime">2.4 h</h3>
                        <p>Total Idle Time</p>
                        <div class="stat-change negative">
                            <i class="fas fa-arrow-up"></i>
                            <span>15% from yesterday</span>
                        </div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon stat-6">
                        <i class="fas fa-tachometer-alt"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="avgSpeed">62 km/h</h3>
                        <p>Average Speed</p>
                        <div class="stat-change positive">
                            <i class="fas fa-arrow-up"></i>
                            <span>3% from yesterday</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Map Section -->
            <div class="map-section">
                <div class="map-header">
                    <h2><i class="fas fa-map"></i> Live Vehicle Tracking Map</h2>
                    <div class="map-controls">
                        <button class="map-control-btn" id="zoomIn">
                            <i class="fas fa-search-plus"></i>
                        </button>
                        <button class="map-control-btn" id="zoomOut">
                            <i class="fas fa-search-minus"></i>
                        </button>
                        <button class="map-control-btn" id="locateAll">
                            <i class="fas fa-crosshairs"></i> Locate All
                        </button>
                        <button class="map-control-btn" id="toggleTraffic">
                            <i class="fas fa-traffic-light"></i> Traffic
                        </button>
                    </div>
                </div>
                <div id="map"></div>
            </div>
            
            <!-- Charts & Vehicles Grid -->
            <div class="d-flex gap-20" style="flex-wrap: wrap;">
                <!-- Left Column - Charts -->
                <div style="flex: 2; min-width: 300px;">
                    <!-- Speed Chart -->
                    <div class="chart-card mb-20">
                        <div class="chart-header">
                            <h3><i class="fas fa-tachometer-alt"></i> Speed Analysis</h3>
                            <div>
                                <label style="font-size: 0.9rem; margin-right: 10px;">Live Updates:</label>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="liveUpdates" checked>
                                    <span class="toggle-slider round"></span>
                                </label>
                            </div>
                        </div>
                        <div class="chart-container">
                            <canvas id="speedChart"></canvas>
                        </div>
                    </div>
                    
                    <!-- Fuel Chart -->
                    <div class="chart-card">
                        <div class="chart-header">
                            <h3><i class="fas fa-gas-pump"></i> Fuel Consumption</h3>
                            <select class="date-picker btn-small">
                                <option>Daily</option>
                                <option selected>Weekly</option>
                                <option>Monthly</option>
                            </select>
                        </div>
                        <div class="chart-container">
                            <div id="fuelChart"></div>
                        </div>
                    </div>
                </div>
                
                <!-- Right Column - Vehicles & Alerts -->
                <div style="flex: 1; min-width: 300px;">
                    <!-- Active Alerts -->
                    <div class="alerts-panel mb-20">
                        <div class="section-header">
                            <h3><i class="fas fa-exclamation-circle"></i> Active Alerts</h3>
                            <span class="text-danger">3 New</span>
                        </div>
                        
                        <div class="alert-list" id="alertList">
                            <!-- Alerts will be populated by JavaScript -->
                        </div>
                        
                        <div class="mt-10" style="text-align: center;">
                            <button class="btn btn-outline btn-small">View All Alerts</button>
                        </div>
                    </div>
                    
                    <!-- Quick Actions -->
                    <div class="chart-card">
                        <div class="section-header">
                            <h3><i class="fas fa-bolt"></i> Quick Actions</h3>
                        </div>
                        
                        <div class="d-flex flex-column gap-10 mt-20">
                            <button class="btn" id="generateReport">
                                <i class="fas fa-file-pdf"></i> Generate Daily Report
                            </button>
                            <button class="btn btn-outline" id="sendAlert">
                                <i class="fas fa-bell"></i> Send Alert to All Drivers
                            </button>
                            <button class="btn btn-outline" id="optimizeRoutes">
                                <i class="fas fa-route"></i> Optimize Today's Routes
                            </button>
                            <button class="btn btn-outline" id="refreshData">
                                <i class="fas fa-sync-alt"></i> Refresh Live Data
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Vehicles Table -->
            <div class="vehicles-section mt-20">
                <div class="section-header">
                    <h3><i class="fas fa-truck-moving"></i> Fleet Vehicles Status</h3>
                    <div class="d-flex align-center gap-15">
                        <input type="text" placeholder="Search vehicle..." style="padding: 8px 15px; border: 1px solid #ddd; border-radius: 5px;">
                        <button class="btn btn-small">Export Data</button>
                    </div>
                </div>
                
                <div class="table-container">
                    <table id="vehiclesTable">
                        <thead>
                            <tr>
                                <th>Vehicle ID</th>
                                <th>Driver</th>
                                <th>Status</th>
                                <th>Location</th>
                                <th>Speed</th>
                                <th>Fuel</th>
                                <th>Last Update</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Vehicle rows will be populated by JavaScript -->
                        </tbody>
                    </table>
                </div>
                
                <div class="d-flex justify-between align-center mt-20">
                    <div>
                        <p>Showing 1-10 of 24 vehicles</p>
                    </div>
                    <div class="d-flex gap-10">
                        <button class="btn btn-small"><i class="fas fa-chevron-left"></i> Previous</button>
                        <button class="btn btn-small">Next <i class="fas fa-chevron-right"></i></button>
                    </div>
                </div>
            </div>
            
            <!-- Footer -->
            <div class="mt-30" style="text-align: center; color: var(--gray); font-size: 0.9rem; padding: 20px 0; border-top: 1px solid #eee;">
                <p>Fastag GPS Dashboard v2.1 | Last updated: <span id="lastUpdated">Just now</span> | © 2023 All rights reserved</p>
            </div>
        </div>
    </div>

    <script>
        // Initialize variables
        let map;
        let vehicles = [];
        let liveUpdatesEnabled = true;
        let updateInterval;
        
        // Initialize the dashboard
        document.addEventListener('DOMContentLoaded', function() {
            initMap();
            initCharts();
            loadVehicles();
            loadAlerts();
            startLiveUpdates();
            
            // Set current date/time
            updateLastUpdated();
            
            // Setup event listeners
            setupEventListeners();
        });
        
        // Initialize Leaflet Map
        function initMap() {
            // Create map centered on a default location
            map = L.map('map').setView([40.7128, -74.0060], 12); // New York coordinates
            
            // Add OpenStreetMap tiles
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors',
                maxZoom: 19
            }).addTo(map);
            
            // Add some sample vehicle markers
            addSampleVehicles();
            
            // Add click event to map
            map.on('click', function(e) {
                console.log('Map clicked at:', e.latlng);
            });
        }
        
        // Add sample vehicles to map
        function addSampleVehicles() {
            const vehicleData = [
                { id: 1, lat: 40.7128, lng: -74.0060, name: "Truck-001", status: "moving", speed: 65, driver: "John Doe" },
                { id: 2, lat: 40.7589, lng: -73.9851, name: "Van-023", status: "idle", speed: 0, driver: "Jane Smith" },
                { id: 3, lat: 40.7489, lng: -73.9680, name: "Car-045", status: "moving", speed: 42, driver: "Robert Johnson" },
                { id: 4, lat: 40.7549, lng: -73.9840, name: "Truck-012", status: "stopped", speed: 0, driver: "Mike Wilson" },
                { id: 5, lat: 40.7290, lng: -73.9965, name: "Van-034", status: "moving", speed: 38, driver: "Sarah Davis" }
            ];
            
            vehicles = vehicleData;
            
            // Create custom icons
            const movingIcon = L.divIcon({
                className: 'custom-div-icon',
                html: '<div style="background-color: #2ecc71; color: white; border-radius: 50%; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border: 3px solid white; box-shadow: 0 2px 5px rgba(0,0,0,0.3);"><i class="fas fa-truck"></i></div>',
                iconSize: [30, 30],
                iconAnchor: [15, 15]
            });
            
            const idleIcon = L.divIcon({
                className: 'custom-div-icon',
                html: '<div style="background-color: #f39c12; color: white; border-radius: 50%; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border: 3px solid white; box-shadow: 0 2px 5px rgba(0,0,0,0.3);"><i class="fas fa-pause"></i></div>',
                iconSize: [30, 30],
                iconAnchor: [15, 15]
            });
            
            const stoppedIcon = L.divIcon({
                className: 'custom-div-icon',
                html: '<div style="background-color: #e74c3c; color: white; border-radius: 50%; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; border: 3px solid white; box-shadow: 0 2px 5px rgba(0,0,0,0.3);"><i class="fas fa-stop"></i></div>',
                iconSize: [30, 30],
                iconAnchor: [15, 15]
            });
            
            // Add markers to map
            vehicles.forEach(vehicle => {
                let icon;
                if (vehicle.status === 'moving') icon = movingIcon;
                else if (vehicle.status === 'idle') icon = idleIcon;
                else icon = stoppedIcon;
                
                const marker = L.marker([vehicle.lat, vehicle.lng], { icon: icon })
                    .addTo(map)
                    .bindPopup(`
                        <b>${vehicle.name}</b><br>
                        Driver: ${vehicle.driver}<br>
                        Status: ${vehicle.status}<br>
                        Speed: ${vehicle.speed} km/h<br>
                        <button onclick="focusVehicle(${vehicle.id})" style="margin-top: 5px; padding: 5px 10px; background: #3498db; color: white; border: none; border-radius: 3px; cursor: pointer;">Track Vehicle</button>
                    `);
                
                vehicle.marker = marker;
            });
            
            // Fit map to show all vehicles
            const group = new L.featureGroup(vehicles.map(v => v.marker));
            map.fitBounds(group.getBounds().pad(0.1));
        }
        
        // Initialize Charts
        function initCharts() {
            // Speed Chart (Chart.js)
            const speedCtx = document.getElementById('speedChart').getContext('2d');
            const speedChart = new Chart(speedCtx, {
                type: 'line',
                data: {
                    labels: ['6:00', '8:00', '10:00', '12:00', '14:00', '16:00', '18:00'],
                    datasets: [{
                        label: 'Average Speed (km/h)',
                        data: [45, 62, 58, 65, 70, 63, 55],
                        borderColor: '#3498db',
                        backgroundColor: 'rgba(52, 152, 219, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.3
                    }, {
                        label: 'Max Speed (km/h)',
                        data: [65, 78, 72, 85, 90, 80, 70],
                        borderColor: '#e74c3c',
                        backgroundColor: 'rgba(231, 76, 60, 0.1)',
                        borderWidth: 2,
                        fill: false,
                        tension: 0.3,
                        borderDash: [5, 5]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            title: {
                                display: true,
                                text: 'Speed (km/h)'
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                        }
                    }
                }
            });
            
            // Fuel Chart (ApexCharts)
            const fuelChart = new ApexCharts(document.querySelector("#fuelChart"), {
                series: [{
                    name: 'Fuel Consumption',
                    data: [45, 52, 38, 24, 33, 26, 21]
                }],
                chart: {
                    height: '100%',
                    type: 'area',
                    toolbar: {
                        show: false
                    }
                },
                colors: ['#27ae60'],
                dataLabels: {
                    enabled: false
                },
                stroke: {
                    curve: 'smooth',
                    width: 3
                },
                fill: {
                    type: 'gradient',
                    gradient: {
                        shadeIntensity: 1,
                        opacityFrom: 0.7,
                        opacityTo: 0.2,
                        stops: [0, 90, 100]
                    }
                },
                xaxis: {
                    categories: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
                },
                yaxis: {
                    title: {
                        text: 'Liters'
                    }
                },
                tooltip: {
                    y: {
                        formatter: function(val) {
                            return val + " L"
                        }
                    }
                }
            });
            
            fuelChart.render();
            
            // Store charts for updates
            window.speedChart = speedChart;
            window.fuelChart = fuelChart;
        }
        
        // Load vehicles into table
        function loadVehicles() {
            const tableBody = document.querySelector('#vehiclesTable tbody');
            tableBody.innerHTML = '';
            
            vehicles.forEach(vehicle => {
                const row = document.createElement('tr');
                
                // Determine status class
                let statusClass = 'status-moving';
                let statusText = 'Moving';
                if (vehicle.status === 'idle') {
                    statusClass = 'status-idle';
                    statusText = 'Idle';
                } else if (vehicle.status === 'stopped') {
                    statusClass = 'status-stopped';
                    statusText = 'Stopped';
                }
                
                // Determine speed bar class
                let speedBarClass = 'speed-normal';
                if (vehicle.speed > 80) speedBarClass = 'speed-danger';
                else if (vehicle.speed > 60) speedBarClass = 'speed-warning';
                
                // Determine fuel level
                const fuelLevel = Math.floor(Math.random() * 100);
                let fuelClass = 'text-success';
                if (fuelLevel < 20) fuelClass = 'text-danger';
                else if (fuelLevel < 40) fuelClass = 'text-warning';
                
                row.innerHTML = `
                    <td><strong>${vehicle.name}</strong></td>
                    <td>${vehicle.driver}</td>
                    <td><span class="vehicle-status ${statusClass}">${statusText}</span></td>
                    <td>New York, NY</td>
                    <td>
                        <div class="speed-indicator">
                            <span>${vehicle.speed} km/h</span>
                            <div class="speed-bar">
                                <div class="speed-fill ${speedBarClass}" style="width: ${Math.min(vehicle.speed, 100)}%"></div>
                            </div>
                        </div>
                    </td>
                    <td class="${fuelClass}">${fuelLevel}%</td>
                    <td>Just now</td>
                    <td>
                        <button class="btn btn-small" onclick="trackVehicle(${vehicle.id})">Track</button>
                        <button class="btn btn-outline btn-small" onclick="sendMessage(${vehicle.id})">Message</button>
                    </td>
                `;
                
                tableBody.appendChild(row);
            });
        }
        
        // Load alerts
        function loadAlerts() {
            const alerts = [
                { type: 'high', icon: 'fa-exclamation-triangle', title: 'Over Speed Alert', message: 'Truck-001 exceeded 80 km/h', time: '2 min ago' },
                { type: 'medium', icon: 'fa-gas-pump', title: 'Fuel Drop Detected', message: 'Van-023: Sudden fuel drop detected', time: '15 min ago' },
                { type: 'low', icon: 'fa-map-marker-alt', title: 'Geo-fence Exit', message: 'Car-045 left assigned area', time: '1 hour ago' },
                { type: 'medium', icon: 'fa-car', title: 'Engine On During Off Hours', message: 'Truck-012 engine started at 3:00 AM', time: '3 hours ago' },
                { type: 'low', icon: 'fa-clock', title: 'Extended Idle Time', message: 'Van-034 idle for over 2 hours', time: '5 hours ago' }
            ];
            
            const alertList = document.getElementById('alertList');
            alertList.innerHTML = '';
            
            alerts.forEach(alert => {
                const alertItem = document.createElement('div');
                alertItem.className = 'alert-item';
                
                let alertTypeClass = 'alert-high';
                if (alert.type === 'medium') alertTypeClass = 'alert-medium';
                else if (alert.type === 'low') alertTypeClass = 'alert-low';
                
                alertItem.innerHTML = `
                    <div class="alert-icon ${alertTypeClass}">
                        <i class="fas ${alert.icon}"></i>
                    </div>
                    <div class="alert-info">
                        <h4>${alert.title}</h4>
                        <p>${alert.message}</p>
                    </div>
                    <div class="alert-time">${alert.time}</div>
                `;
                
                alertList.appendChild(alertItem);
            });
        }
        
        // Start live updates
        function startLiveUpdates() {
            if (updateInterval) clearInterval(updateInterval);
            
            updateInterval = setInterval(() => {
                if (liveUpdatesEnabled) {
                    updateStats();
                    updateMapMarkers();
                    updateLastUpdated();
                }
            }, 5000); // Update every 5 seconds
        }
        
        // Update statistics
        function updateStats() {
            // Update active vehicles (random +/- 1)
            const activeVehiclesEl = document.getElementById('activeVehicles');
            let current = parseInt(activeVehiclesEl.textContent);
            let change = Math.random() > 0.5 ? 1 : -1;
            if (current + change >= 20 && current + change <= 28) {
                activeVehiclesEl.textContent = current + change;
            }
            
            // Update distance (add random 10-50 km)
            const distanceEl = document.getElementById('totalDistance');
            let distance = parseInt(distanceEl.textContent.replace(',', ''));
            distanceEl.textContent = (distance + Math.floor(Math.random() * 40 + 10)).toLocaleString() + ' km';
            
            // Update fuel (add random 5-20 L)
            const fuelEl = document.getElementById('fuelUsed');
            let fuel = parseInt(fuelEl.textContent);
            fuelEl.textContent = (fuel + Math.floor(Math.random() * 15 + 5)) + ' L';
            
            // Update alerts (random 1-5)
            const alertsEl = document.getElementById('activeAlerts');
            alertsEl.textContent = Math.floor(Math.random() * 5 + 1);
            
            // Update idle time (add random 0.1-0.5 h)
            const idleEl = document.getElementById('idleTime');
            let idle = parseFloat(idleEl.textContent);
            idleEl.textContent = (idle + Math.random() * 0.4 + 0.1).toFixed(1) + ' h';
            
            // Update average speed (random 55-70)
            const speedEl = document.getElementById('avgSpeed');
            speedEl.textContent = Math.floor(Math.random() * 15 + 55) + ' km/h';
        }
        
        // Update map markers (simulate movement)
        function updateMapMarkers() {
            vehicles.forEach(vehicle => {
                if (vehicle.status === 'moving') {
                    // Move marker slightly
                    const lat = vehicle.lat + (Math.random() - 0.5) * 0.01;
                    const lng = vehicle.lng + (Math.random() - 0.5) * 0.01;
                    
                    // Update vehicle position
                    vehicle.lat = lat;
                    vehicle.lng = lng;
                    
                    // Update marker position
                    vehicle.marker.setLatLng([lat, lng]);
                    
                    // Randomly change status
                    if (Math.random() > 0.9) {
                        vehicle.status = 'idle';
                        vehicle.speed = 0;
                    }
                } else if (vehicle.status === 'idle') {
                    // Randomly start moving again
                    if (Math.random() > 0.8) {
                        vehicle.status = 'moving';
                        vehicle.speed = Math.floor(Math.random() * 40 + 30);
                    }
                }
                
                // Update speed slightly
                if (vehicle.status === 'moving') {
                    vehicle.speed += Math.floor((Math.random() - 0.5) * 10);
                    if (vehicle.speed < 10) vehicle.speed = 10;
                    if (vehicle.speed > 100) vehicle.speed = 100;
                }
            });
            
            // Reload table to reflect changes
            loadVehicles();
        }
        
        // Update last updated timestamp
        function updateLastUpdated() {
            const now = new Date();
            const timeString = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            document.getElementById('lastUpdated').textContent = timeString;
        }
        
        // Setup event listeners
        function setupEventListeners() {
            // Mobile menu toggle
            document.getElementById('mobileMenuBtn').addEventListener('click', function() {
                document.getElementById('sidebar').classList.toggle('active');
            });
            
            // Map controls
            document.getElementById('zoomIn').addEventListener('click', function() {
                map.zoomIn();
            });
            
            document.getElementById('zoomOut').addEventListener('click', function() {
                map.zoomOut();
            });
            
            document.getElementById('locateAll').addEventListener('click', function() {
                const group = new L.featureGroup(vehicles.map(v => v.marker));
                map.fitBounds(group.getBounds().pad(0.1));
            });
            
            document.getElementById('toggleTraffic').addEventListener('click', function() {
                alert('Traffic layer would be toggled in a real implementation');
            });
            
            // Live updates toggle
            document.getElementById('liveUpdates').addEventListener('change', function(e) {
                liveUpdatesEnabled = e.target.checked;
                if (liveUpdatesEnabled) {
                    startLiveUpdates();
                } else {
                    clearInterval(updateInterval);
                }
            });
            
            // Quick action buttons
            document.getElementById('generateReport').addEventListener('click', function() {
                alert('Daily report generation started. Check reports section in a few minutes.');
            });
            
            document.getElementById('sendAlert').addEventListener('click', function() {
                alert('Alert sent to all drivers.');
            });
            
            document.getElementById('optimizeRoutes').addEventListener('click', function() {
                alert('Route optimization completed. Saved to trips section.');
            });
            
            document.getElementById('refreshData').addEventListener('click', function() {
                updateStats();
                updateMapMarkers();
                updateLastUpdated();
                alert('Data refreshed successfully.');
            });
        }
        
        // Vehicle tracking functions
        function trackVehicle(vehicleId) {
            const vehicle = vehicles.find(v => v.id === vehicleId);
            if (vehicle) {
                map.setView([vehicle.lat, vehicle.lng], 15);
                vehicle.marker.openPopup();
            }
        }
        
        function focusVehicle(vehicleId) {
            trackVehicle(vehicleId);
        }
        
        function sendMessage(vehicleId) {
            const vehicle = vehicles.find(v => v.id === vehicleId);
            if (vehicle) {
                const message = prompt(`Send message to driver of ${vehicle.name}:`, "Please check your speed.");
                if (message) {
                    alert(`Message sent to ${vehicle.driver}: "${message}"`);
                }
            }
        }
        
        // Export to global scope
        window.trackVehicle = trackVehicle;
        window.focusVehicle = focusVehicle;
        window.sendMessage = sendMessage;
    </script>
</body>
</html>
